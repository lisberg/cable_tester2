(version 1)

# Cable tester custom design rules (JLCPCB 4-layer, conservative / no-surcharge class).
# Net classes are assigned by pattern in the project file:
#   FIXTURE = *EXT*, *SHELL*   (connector-side nodes and fixture ID lines, before the series resistor; up to ±30 V)
#   STIM    = */STIM, */MUX*   (global stimulus / ADC bus and the mux outputs feeding it)
#   POWER   = rails, SPI = shift-chain clocks/data (*SCK*, *MOSI*, *MISO*, */RCLK*, */PL_N, */PL5_N)

(rule "Fixture nets keep away from logic"
	(condition "A.NetClass == 'FIXTURE' && B.NetClass != 'FIXTURE' && B.Type != 'Zone'")
	(constraint clearance (min 0.3mm)))

(rule "SPI clocks keep away from fixture nets"
	(condition "A.NetClass == 'SPI' && B.NetClass == 'FIXTURE'")
	(constraint clearance (min 0.5mm)))

(rule "Fixture to fixture (30 V rating, IPC-2221 B2)"
	(condition "A.NetClass == 'FIXTURE' && B.NetClass == 'FIXTURE'")
	(constraint clearance (min 0.2mm)))
